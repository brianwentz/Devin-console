{
  "name": "devin-workspaces",
  "version": "1.1.0",
  "private": true,
  "description": "Devin Workspaces desktop client",
  "author": "brianwentz",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "acp:probe": "npm run build:acp && node out/scripts/acp-probe.cjs",
    "build:acp": "node scripts/build-acp.mjs",
    "os:input": "npm run build && node out/scripts/os-input.cjs",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "smoke:install": "npm run dist:win:smoke && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-install.ps1 -Isolated",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "measure:tabs": "npm run build && node out/scripts/measure-tabs.cjs",
    "rebuild:native": "electron-builder install-app-deps",
    "claude:sdk-probe": "npm run build && node out/scripts/claude-sdk-probe.cjs",
    "claude:hooks-probe": "npm run build && node out/scripts/claude-hooks-probe.cjs",
    "claude:store-probe": "npm run build && node out/scripts/claude-store-probe.cjs",
    "hosts:probe": "npm run build && node out/scripts/hosts-probe.cjs",
    "dist:win:smoke": "npm run build && electron-builder --win nsis --x64 --publish never -c.appId=ai.devin.workspaces.smoke -c.productName=\"Devin Workspaces Smoke\" -c.nsis.shortcutName=\"Devin Workspaces Smoke\" -c.nsis.artifactName=\"DevinWorkspaces-Smoke-Setup-${version}.${ext}\" -c.directories.output=dist/smoke",
    "smoke:install:real": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-install.ps1"
  },
  "workspaces": [
    "tools/lint"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "5.9.3"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@electron/fuses": "2.1.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron-updater": "6.8.9",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "4.2.2",
    "json-schema-traverse": "1.0.0",
    "lucide-react": "1.55.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "require-from-string": "2.0.2",
    "zod": "4.6.5"
  },
  "build": {
    "appId": "ai.devin.workspaces",
    "productName": "Devin Workspaces",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/node-pty/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/ajv/**",
      "node_modules/ajv-formats/**",
      "node_modules/fast-deep-equal/**",
      "node_modules/fast-uri/**",
      "node_modules/json-schema-traverse/**",
      "node_modules/require-from-string/**",
      "node_modules/zod/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/@anthropic-ai/sdk/**",
      "!node_modules/@modelcontextprotocol/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "DevinWorkspaces-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Devin Workspaces",
      "artifactName": "DevinWorkspaces-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "brianwentz",
        "repo": "devin-workspace"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "resetAdHocDarwinSignature": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/ajv/**",
      "node_modules/ajv-formats/**",
      "node_modules/fast-deep-equal/**",
      "node_modules/fast-uri/**",
      "node_modules/json-schema-traverse/**",
      "node_modules/require-from-string/**",
      "node_modules/zod/**"
    ],
    "npmRebuild": false
  }
}
